# Copia este archivo a .env y completa tus credenciales
# Obtén tus credenciales de Spotify en: https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui

# Proxies opcionales (recomendado para evitar bloqueos)
# PROXY_LIST=http://proxy1:port,http://user:pass@proxy2:port

# BrightData (recomendado) - https://brightdata.com/
# BRIGHTDATA_USER=tu_usuario_brightdata
# BRIGHTDATA_PASS=tu_password_brightdata
# BRIGHTDATA_PORT=22225

# Oxylabs - https://oxylabs.io/
# OXYLABS_USER=tu_usuario_oxylabs
# OXYLABS_PASS=tu_password_oxylabs

# Smartproxy - https://smartproxy.com/
# SMARTPROXY_USER=tu_usuario_smartproxy
# SMARTPROXY_PASS=tu_password_smartproxy
# SMARTPROXY_PORT=10000
